{
  "name": "eve-marketplace",
  "version": "0.1.0",
  "description": "Eve extension that loads skills from Cursor, Claude Code, and Codex plugin marketplaces at runtime.",
  "license": "MIT",
  "author": "Moritz Meyer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrzmyr/eve-marketplace.git"
  },
  "homepage": "https://github.com/mrzmyr/eve-marketplace#readme",
  "bugs": "https://github.com/mrzmyr/eve-marketplace/issues",
  "keywords": [
    "eve",
    "eve-extension",
    "skills",
    "plugin-marketplace",
    "claude-code",
    "cursor",
    "codex",
    "agent-skills"
  ],
  "type": "module",
  "eve": {
    "extension": {
      "source": "./extension",
      "dist": "./dist/extension"
    }
  },
  "files": [
    "extension",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.mjs"
    }
  },
  "scripts": {
    "build": "eve extension build",
    "prepublishOnly": "bun run typecheck && bun run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/connect": "^0.8.0",
    "semver": "^7.7.2",
    "yaml": "^2.9.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "eve": ">=0.81.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/node": "^24",
    "@types/semver": "^7.7.0",
    "eve": "0.81.1",
    "typescript": "^5.9.3"
  }
}
